{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Ejecutar Backend Spring Boot",
      "type": "shell",
      "command": "powershell -ExecutionPolicy Bypass -File run_backend.ps1",
      "isBackground": true,
      "problemMatcher": {
        "pattern": {
          "regexp": "^$"
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting Spring Boot",
          "endsPattern": "Backend Spring Boot listo"
        }
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared"
      }
    }
  ]
}
